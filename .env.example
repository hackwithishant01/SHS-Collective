# ---------------------------------------------------------------------------
# SHS Collective — environment variables
# Copy to `.env.local` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL used for canonical links, sitemap and structured data.
# No trailing slash. Use the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. Leave empty to use the embedded local
# development database (PGlite, stored in .data/pglite). Production requires
# a real PostgreSQL/Supabase connection string. Server-only.
DATABASE_URL=

# Set to "false" only for a local PostgreSQL without TLS.
DATABASE_SSL=

# Embedded database directory. Development/testing only (server-only).
SHS_DB_DIR=.data/pglite

# Media storage. "local" writes to .data/uploads; "supabase" uses Storage.
MEDIA_STORAGE=local

# Required when MEDIA_STORAGE=supabase. Server-only service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Optional: override the business WhatsApp number at runtime. The database
# setting managed in the admin dashboard takes precedence when present.
BUSINESS_WHATSAPP_NUMBER=

# Optional: salt for hashing request IPs in logs/rate limiting. If omitted a
# random per-process salt is used (rate limits remain correct, logs are not
# comparable across restarts).
REQUEST_IP_SALT=
